# Doxygen configuration for ktplace.
#
# Run from the repository root:
#     tools/doxygen-1.18.0/bin/doxygen Doxyfile
# The generated site lands in docs/html/index.html.
#
# This file only sets the tags that differ from the defaults, so it stays small
# and forward compatible: doxygen fills in everything else.

#---------------------------------------------------------------------------
# Project
#---------------------------------------------------------------------------
PROJECT_NAME           = "ktplace"
PROJECT_BRIEF          = "Analytical placement: k-truss analytic placement, detail placement, legalisation, and placement visualisation"
OUTPUT_DIRECTORY       = docs
HTML_OUTPUT            = html
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

#---------------------------------------------------------------------------
# Which sources are documented
#---------------------------------------------------------------------------
# Only our own code. CImg.h is a 3.5 MB vendored single header and
# third_party/ is upstream code we do not document.
INPUT                  = src \
                         README.md \
                         benchmark/README.md \
                         docs/simpl.md
FILE_PATTERNS          = *.h *.cc *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */CImg.h \
                         src/test/* \
                         */build/*
EXCLUDE_SYMBOLS        =

# Everything in the headers is already commented, so documentation is opt-in
# and undocumented internals do not clutter the API view.
EXTRACT_ALL            = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
WARN_NO_PARAMDOC       = YES
WARN_IF_UNDOCUMENTED   = NO
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
BUILTIN_STL_SUPPORT    = YES
SORT_MEMBER_DOCS       = YES
DISTRIBUTE_GROUP_DOC   = YES
SUBGROUPING            = YES
INLINE_INHERITED_MEMB  = YES
TAB_SIZE               = 4

#---------------------------------------------------------------------------
# Documented entities
#---------------------------------------------------------------------------
# Entity extraction is controlled by the EXTRACT_* defaults (all YES), which
# doxygen 1.18 no longer accepts as explicit configuration tags.
EXTRACT_LOCAL_CLASSES  = NO
EXTRACT_ANON_NSPACES   = NO

#---------------------------------------------------------------------------
# Cross references: this is what shows the API relationships without needing
# a graphviz install, which this machine does not have.
#---------------------------------------------------------------------------
ALWAYS_DETAILED_SEC    = YES
INLINE_INHERITED_MEMB  = YES
REFERENCES_RELATION    = YES
REFERENCED_BY_RELATION = YES
VERBATIM_HEADERS       = YES

#---------------------------------------------------------------------------
# Source code display, for the "where is this used" question
#---------------------------------------------------------------------------
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = YES
VERBATIM_HEADERS       = YES

#---------------------------------------------------------------------------
# Dot / graphs: intentionally off, no graphviz available. Without it the
# inheritance graph pages are not produced, but REFERENCES_RELATION and
# REFERENCED_BY_RELATION above still give the API relationships as text.
#---------------------------------------------------------------------------
HAVE_DOT               = NO
COLLABORATION_GRAPH    = NO
GROUP_GRAPHS           = NO
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
GRAPHICAL_HIERARCHY    = NO
DIRECTORY_GRAPH        = YES

#---------------------------------------------------------------------------
# Preprocessor
#---------------------------------------------------------------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = src
PREDEFINED             = __cplusplus
SKIP_FUNCTION_MACROS   = YES

#---------------------------------------------------------------------------
# Output
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO
GENERATE_TREEVIEW      = YES
GENERATE_TODOLIST      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = YES

QUIET                  = YES
WARNINGS               = YES
WARN_LOGFILE           = docs/doxygen-warnings.log
