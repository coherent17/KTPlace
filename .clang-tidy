Checks: >
  -*,
  readability-identifier-naming,
  misc-include-cleaner,
  modernize-*,
  -modernize-use-trailing-return-type,
  -modernize-avoid-c-arrays,
  -modernize-use-nodiscard,
  -modernize-macro-to-enum,
  -modernize-return-braced-init-list
HeaderFilterRegex: '/src/'
CheckOptions:
  readability-identifier-naming.FunctionCase: camelBack
  readability-identifier-naming.FunctionIgnoredRegexp: '^main$'
  readability-identifier-naming.MethodCase: camelBack
  readability-identifier-naming.MemberCase: camelBack
  readability-identifier-naming.VariableCase: camelBack
  readability-identifier-naming.ParameterCase: camelBack
  readability-identifier-naming.ConstantCase: camelBack
  readability-identifier-naming.ConstexprVariableCase: camelBack
  readability-identifier-naming.EnumConstantCase: CamelCase
  misc-include-cleaner.MissingIncludes: false
  misc-include-cleaner.IgnoreHeaders: 'boost/.*'
