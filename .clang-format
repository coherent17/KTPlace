# clang-format configuration for KTPlace.
# Tuned to the existing code style: 4-space indent, braces attached,
# non-indented namespace blocks, 100-column limit.

BasedOnStyle: Google

IndentWidth: 4
ContinuationIndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 100

AccessModifierOffset: -4
NamespaceIndentation: None
FixNamespaceComments: true

PointerAlignment: Right
ReferenceAlignment: Pointer
DerivePointerAlignment: false

BreakBeforeBraces: Custom
BraceWrapping:
  AfterControlStatement: Never

AllowShortFunctionsOnASingleLine: Empty
AllowShortLambdasOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false

SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeCategories:
  # The matching header first, then the rest of the project's, then the
  # third-party and standard ones together.
  - Regex: '^"[^/]+"'
    Priority: 1
  - Regex: '^<'
    Priority: 3
  - Regex: '.*'
    Priority: 2

AlignAfterOpenBracket: Align
AlignOperands: Align
AlignTrailingComments: true

ReflowComments: false
MaxEmptyLinesToKeep: 2
KeepEmptyLinesAtTheStartOfBlocks: false

BinPackArguments: true
BinPackParameters: true