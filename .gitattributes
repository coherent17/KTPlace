# Check every text file out with LF line endings, on every OS.
#
# Git for Windows converts to CRLF by default, and a CRLF shell script or
# Makefile fails ("/bin/sh^M: not found", "missing separator"). The repository
# already stores LF, so this changes no content; it only stops the conversion.
* text=auto eol=lf

# Binary, whatever the heuristic says.
*.gz  binary
*.png binary
*.gif binary
*.jpg binary
benchmark/lefdef/ISPD_2015/evaluator/placement_checker binary
