# Build artifacts
build/
src/build/
build-cov/
build-static/
*.o
*.d

# Per-binary gcov payloads, written into the repository root by the coverage
# script and cleaned by `make coverage-clean`.
*.gcov.json.gz

# Generated by the build into the repository root (templates in scripts/)
/ktplace.sh
/ktplace.csh

# Generated placements, plots, logs and suite drivers: a run writes here, so
# nothing in it belongs in the commit.
output/
out.pl

# Run transcript
ktplace.log
*.log

# The benchmark suites are committed, gzipped, except ISPD 2006;
# fetch_benchmarks.py downloads any of them from their original publishers.
benchmark/.cache/
benchmark/__pycache__/

# ISPD 2006 is fetched, not committed; only its evaluator is.
benchmark/bookshelf/ISPD06/*
!benchmark/bookshelf/ISPD06/evaluator/

# Editor / OS noise
*.swp
.DS_Store
.claude
.opencode
logs/

# Local editor tooling (kept out of the repo)
.cursorrules
# Development notes are ignored; the curated write-ups are tracked.
docs/*
!docs/simpl.md
!docs/docker.md
!docs/visualization.md
!docs/images/
ref/
*.whl

# Python bytecode
__pycache__/
*.pyc

# clangd compilation database: regenerated by `make compile-commands`.
# The include paths are absolute, so a committed copy is wrong elsewhere, and a
# stale one makes clangd report diagnostics from flags the build does not use.
compile_commands.json

# Default work-directory output: a run with no -w writes into the current
# directory, so these land in the repo root.
placed.pl
plots/
